        },
        {
          "event_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb4",
          "entity_type": "crop_activity",
          "entity_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb5",
