NWDP_BOUNDARY_RUNTIME_LOOKUP_RATE_LIMIT_ENABLED=false
PROJECT_VILLAGE_RESOLUTION_CANONICAL_APPLY_ENABLED=false

# Production requires APP_ENVIRONMENT=production, a unique JWT_SECRET of at
# least 32 characters, a non-development DB_PASSWORD,
