# Local development defaults. Never copy these into production unchanged.
APP_ENVIRONMENT=development
DB_USER=agrios_user
DB_PASSWORD=agrios_dev_2026
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrios_dev
# DB_SSLMODE=require
JWT_SECRET=agrios-dev-secret-change-in-production
AUTH_EXPOSE_DEV_OTP=true
API_DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
WEATHER_PROVIDER_LIVE_EXECUTION_ENABLED=false
SOIL_PROVIDER_LIVE_EXECUTION_ENABLED=false
